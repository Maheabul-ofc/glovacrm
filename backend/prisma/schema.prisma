generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------
// FOUNDATION MODULE
// -----------------------------------------

model Tenant {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String  @unique
  subdomain String? @unique
  logoUrl   String?
  status    String  @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  settings  Json?   @default("{}")
  plan      String  @default("TRIAL") // TRIAL, STARTER, PROFESSIONAL, ENTERPRISE

  // Subscription & Registration fields
  industry     String?
  country      String?   @default("IN")
  billingEmail String?
  trialEndsAt  DateTime?

  users            User[]
  auditLogs        AuditLog[]
  leads            Lead[]
  pipelineStages   PipelineStage[]
  customFields     CustomFieldConfig[]
  tags             Tag[]
  integrations     IntegrationConfig[]
  calls            Call[]
  whatsappMessages WhatsAppMessage[]
  campaigns        Campaign[]
  services         Service[]
  waTemplateCategories WhatsAppTemplateCategory[]
  waTemplates          WhatsAppTemplate[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  Notification Notification[]
  Subscription Subscription?
  PaymentTransaction PaymentTransaction[]

  @@map("tenants")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid
  email        String
  passwordHash String
  firstName    String
  lastName     String?
  phone        String?
  avatarUrl    String?
  role         UserRole @default(TELECALLER)
  isOwner      Boolean  @default(false) // marks the Business Owner of a tenant
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE, INVITED

  lastLoginAt DateTime?
  invitedById String?   @db.Uuid

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions      Session[]
  auditLogs     AuditLog[]
  assignedLeads Lead[]         @relation("AssignedTo")
  activities    LeadActivity[]
  calls         Call[]
  createdTemplates  WhatsAppTemplate[] @relation("TemplateCreatedBy")
  updatedTemplates  WhatsAppTemplate[] @relation("TemplateUpdatedBy")

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  Notification Notification[]

  @@unique([tenantId, email])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  TEAM_MANAGER
  TELECALLER
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  refreshToken String   @unique
  expiresAt    DateTime
  userAgent    String?
  ipAddress    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @db.Uuid
  userId     String? @db.Uuid
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// -----------------------------------------
// LEAD MANAGEMENT MODULE
// -----------------------------------------

model PipelineStage {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @db.Uuid
  name     String
  position Int
  color    String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@map("pipeline_stages")
}

model CustomFieldConfig {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @db.Uuid
  name     String
  label    String
  type     String // text, number, date, select, multiselect
  options  Json? // For select/multiselect
  required Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@map("custom_field_configs")
}

model Tag {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @db.Uuid
  name     String
  color    String?

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  LeadTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@map("tags")
}

model Lead {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @db.Uuid
  assignedToId String? @db.Uuid
  stageId      String? @db.Uuid

  // Standard Fields
  firstName   String
  lastName    String?
  phone       String
  altPhone    String?
  email       String?
  companyName String?
  designation String?

  // Metadata
  source     String?
  sourceId   String?
  campaignId String?
  score      Int     @default(0)
  priority   String  @default("NORMAL") // LOW, NORMAL, HIGH, URGENT

  // New fields from Ramdhenu CRM
  status          String  @default("NEW") // NEW, FOLLOW_UP, INTERESTED, NOT_INTERESTED, CONVERTED, CLOSED
  conversionChance Int    @default(0) // 0-5 star rating
  serviceName     String? // Service/product the lead is interested in
  businessDetails String? @db.Text // What the customer's business is about
  revenueAmount   Float?  // Revenue when converted (in INR)
  cancelReason    String? // Why was the lead cancelled/closed
  inquiryDate     DateTime? // When the inquiry originally came in
  initialNotes    String? @db.Text // First conversation details

  // Dynamic Data
  customData Json? @default("{}")

  // Timestamps & State
  notes           String?   @db.Text
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?

  // Relations
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo       User?             @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  stage            PipelineStage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  tags             LeadTag[]
  activities       LeadActivity[]
  calls            Call[]
  whatsappMessages WhatsAppMessage[]
  campaigns        Campaign[]        @relation("CampaignLeads")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([assignedToId])
  @@index([stageId])
  @@index([phone])
  @@map("leads")
}

model LeadTag {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId String @db.Uuid
  tagId  String @db.Uuid

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([leadId, tagId])
  @@map("lead_tags")
}

model LeadActivity {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId   String  @db.Uuid
  tenantId String  @db.Uuid
  userId   String? @db.Uuid

  type        String // CALL, NOTE, STATUS_CHANGE, WHATSAPP, EMAIL
  description String @db.Text
  metadata    Json?  @default("{}") // call duration, previous status, etc.

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([tenantId])
  @@map("lead_activities")
}

model IntegrationConfig {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @db.Uuid
  provider String // META, GOOGLE, INDIAMART, JUSTDIAL
  config   Json // Encrypted tokens, page IDs, keys
  isActive Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, provider])
  @@map("integration_configs")
}

model Call {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  leadId   String @db.Uuid
  userId   String @db.Uuid // Telecaller who made the call

  provider       String // EXOTEL, TWILIO
  providerCallId String? @unique

  direction String // INBOUND, OUTBOUND
  status    String // INITIATED, RINGING, IN_PROGRESS, COMPLETED, MISSED, FAILED

  duration     Int     @default(0) // in seconds
  recordingUrl String?
  notes        String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([leadId])
  @@index([userId])
  @@map("calls")
}

model WhatsAppMessage {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  leadId   String @db.Uuid

  direction   String // INBOUND, OUTBOUND
  status      String // SENT, DELIVERED, READ, FAILED
  messageType String // TEXT, TEMPLATE, IMAGE, DOCUMENT
  content     String

  providerMessageId String? @unique

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([leadId])
  @@map("whatsapp_messages")
}

model Campaign {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid

  name        String
  description String?
  status      String  @default("DRAFT") // DRAFT, SCHEDULED, RUNNING, COMPLETED, PAUSED
  type        String  @default("WHATSAPP") // WHATSAPP, EMAIL, SMS

  targetAudience Json? // Store filter criteria or static lead IDs
  templateName   String? // Name of WhatsApp template to send

  metrics Json? // Sent, Delivered, Read, Clicked rates

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[] @relation("CampaignLeads")

  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@map("campaigns")
}

model Notification {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @db.Uuid
  userId      String  @db.Uuid // who receives it
  title       String
  description String
  isRead      Boolean @default(false)
  type        String  @default("SYSTEM") // CALL, WHATSAPP, SYSTEM
  linkUrl     String? // e.g. /dashboard/leads/:id

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
  @@index([tenantId])
  @@map("notifications")
}

model Service {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  name     String
  isActive Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@map("services")
}

// -----------------------------------------
// SUBSCRIPTION & BILLING MODULE
// -----------------------------------------

model SubscriptionPlan {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  price       Float    // monthly price in INR
  features    Json?    @default("[]") // list of features
  isActive    Boolean  @default(true)
  
  subscriptions Subscription[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("subscription_plans")
}

model Subscription {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @db.Uuid @unique
  planId          String   @db.Uuid
  
  providerSubId   String?  @unique // if using provider subscriptions (optional)
  status          String   @default("ACTIVE") // ACTIVE, CANCELED, PAST_DUE
  
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  
  cancelAtPeriodEnd Boolean @default(false)
  
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments        PaymentTransaction[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("subscriptions")
}

model PaymentTransaction {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @db.Uuid
  subscriptionId  String?  @db.Uuid
  
  providerOrderId   String   @unique
  providerPaymentId String?  @unique
  providerSignature String?
  
  amount          Float
  currency        String   @default("INR")
  status          String   @default("PENDING") // PENDING, SUCCESS, FAILED
  
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("payment_transactions")
}

// -----------------------------------------
// UPGRADE REQUEST MODULE
// -----------------------------------------

model UpgradeRequest {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyName String
  industry    String?
  country     String?  @default("IN")
  firstName   String
  lastName    String?
  email       String
  phone       String?
  planName    String   // Starter, Professional, Enterprise
  planPrice   Float    // 999, 2499, 4999
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNotes  String?
  reviewedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@map("upgrade_requests")
}

// -----------------------------------------
// WHATSAPP TEMPLATE MODULE
// -----------------------------------------

model WhatsAppTemplateCategory {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  name     String
  color    String? @default("#6366f1")

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templates WhatsAppTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("wa_template_categories")
}

model WhatsAppTemplate {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @db.Uuid
  categoryId String? @db.Uuid

  name        String
  content     String   @db.Text
  variables   Json?    @default("[]")
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, DELETED
  version     Int      @default(1)

  // Future WhatsApp API fields (not used now, ready for later)
  waTemplateName  String?
  waLanguage      String?  @default("en")
  waStatus        String?  // PENDING, APPROVED, REJECTED (Meta review status)
  waHeaderType    String?  // TEXT, IMAGE, DOCUMENT, VIDEO
  waHeaderContent String?
  waFooter        String?
  waButtons       Json?

  createdById     String @db.Uuid
  lastUpdatedById String @db.Uuid

  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      WhatsAppTemplateCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy     User                      @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  lastUpdatedBy User                      @relation("TemplateUpdatedBy", fields: [lastUpdatedById], references: [id], onDelete: Cascade)
  versions      WhatsAppTemplateVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([categoryId])
  @@index([status])
  @@map("wa_templates")
}

model WhatsAppTemplateVersion {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String @db.Uuid
  tenantId   String @db.Uuid

  version     Int
  content     String @db.Text
  variables   Json?  @default("[]")
  changeNote  String?
  changedById String @db.Uuid

  template WhatsAppTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([templateId])
  @@index([tenantId])
  @@map("wa_template_versions")
}
